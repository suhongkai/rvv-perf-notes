+    }
+#endif
+
+    // Scalar fallback.
+    for (int y = 0; y < nr / 4; y++) {
+        const block_q8_0x4 * a_ptr = (const block_q8_0x4 *) vy + (y * nb);
+        for (int x = 0; x < nc / ncols_interleaved; x++) {
+            const block_q4_1x16 * b_ptr = (const block_q4_1x16 *) vx + (x * nb);
+
+            float sumf[4][16];
+            for (int r = 0; r < 4; r++) {
+                for (int i = 0; i < ncols_interleaved; i++) {
+                    sumf[r][i] = 0.0f;
+                }
+            }
+
+            for (int l = 0; l < nb; l++) {
+                // Sum of the activations of the 4 rows.
+                float sum_a[4];
+                for (int r = 0; r < 4; r++) {
+                    int sum_a_q = 0;
+                    for (int j = 0; j < qk / 2; j++) {
+                        sum_a_q += (int) a_ptr[l].qs[j * 4 + r] + (int) a_ptr[l].qs[qk / 2 * 4 + j * 4 + r];
+                    }
+                    sum_a[r] = (float) sum_a_q * GGML_CPU_FP16_TO_FP32(a_ptr[l].d[r]);
+                }
+
+                for (int i = 0; i < ncols_interleaved; i++) {
+                    int isum_0 = 0;
+                    int isum_1 = 0;
+                    int isum_2 = 0;
+                    int isum_3 = 0;
+                    for (int j = 0; j < qk / 2; j++) {
+                        const uint8_t packed = b_ptr[l].qs[j * ncols_interleaved + i];
+                        const int lo = (int8_t) (packed << 4) >> 4;  // (q - 8), low nibble
+                        const int hi = (int8_t) (packed) >> 4;      // (q - 8), high nibble
+
+                        const int k0 = j * 4 + 0;
+                        const int k1 = j * 4 + 1;
+                        const int k2 = j * 4 + 2;
+                        const int k3 = j * 4 + 3;
+
+                        isum_0 += lo * (int) a_ptr[l].qs[k0] + hi * (int) a_ptr[l].qs[qk / 2 * 4 + k0];
+                        isum_1 += lo * (int) a_ptr[l].qs[k1] + hi * (int) a_ptr[l].qs[qk / 2 * 4 + k1];
+                        isum_2 += lo * (int) a_ptr[l].qs[k2] + hi * (int) a_ptr[l].qs[qk / 2 * 4 + k2];
+                        isum_3 += lo * (int) a_ptr[l].qs[k3] + hi * (int) a_ptr[l].qs[qk / 2 * 4 + k3];
+                    }
+
+                    const float d_w = GGML_CPU_FP16_TO_FP32(b_ptr[l].d[i]);
+                    const float m_w = GGML_CPU_FP16_TO_FP32(b_ptr[l].m[i]);
+
+                    const int isum[4] = { isum_0, isum_1, isum_2, isum_3 };
+
+                    for (int r = 0; r < 4; r++) {
+                        sumf[r][i] += d_w * GGML_CPU_FP16_TO_FP32(a_ptr[l].d[r]) * (float) isum[r] + m_w * sum_a[r];
+                    }
+                }
+            }
+
+            for (int r = 0; r < 4; r++) {
+                for (int i = 0; i < ncols_interleaved; i++) {
+                    s[(y * 4 + r) * bs + x * ncols_interleaved + i] = sumf[r][i];
+                }
+            }
         }
     }
 }
