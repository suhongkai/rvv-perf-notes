+// 6-bit scale of sub-block `sb` (0..15): 8 low nibbles in scales[0..8), then the
+// 2 high bits of sub-block sb in bits (2*(sb%4), 2*(sb%4)+1) of scales[8 + sb/4].
+// Real scale value is v - 32.
+static inline uint8_t q3_K_scale_6bit(const uint8_t * scales, int sb) {
+    const uint8_t lo = (sb < 8) ? (scales[sb] & 0x0F) : (scales[sb - 8] >> 4);
+    const uint8_t hi = (scales[8 + (sb % 4)] >> (2 * (sb / 4))) & 0x03;
+    return lo | (hi << 4);
+}
