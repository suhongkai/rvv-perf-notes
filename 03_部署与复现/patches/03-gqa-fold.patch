+        vfloat32m4_t a0 = __riscv_vfmv_v_f_f32m4(0.0f, vlmax);
+        vfloat32m4_t a1 = __riscv_vfmv_v_f_f32m4(0.0f, vlmax);
+        vfloat32m4_t a2 = __riscv_vfmv_v_f_f32m4(0.0f, vlmax);
+        vfloat32m4_t a3 = __riscv_vfmv_v_f_f32m4(0.0f, vlmax);
+
+        for (; (size_t) (n - i) >= vlmax; i += (int) vlmax) {
+            const size_t vl = __riscv_vsetvl_e16m2(n - i);
+            const vfloat16m2_t vx = __riscv_vle16_v_f16m2((const _Float16 *) (x + i), vl);
+            GGML_F16_DOT4_LOAD(0); GGML_F16_DOT4_FMA(0);
+            GGML_F16_DOT4_LOAD(1); GGML_F16_DOT4_FMA(1);
+            GGML_F16_DOT4_LOAD(2); GGML_F16_DOT4_FMA(2);
+            GGML_F16_DOT4_LOAD(3); GGML_F16_DOT4_FMA(3);
+        }
