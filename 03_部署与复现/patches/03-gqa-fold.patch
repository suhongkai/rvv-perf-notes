+        sum1 = __riscv_vfmv_f_s_f32m1_f32(__riscv_vfredusum_vs_f32m4_f32m1(a1, zero, vlmax));
+        sum2 = __riscv_vfmv_f_s_f32m1_f32(__riscv_vfredusum_vs_f32m4_f32m1(a2, zero, vlmax));
+        sum3 = __riscv_vfmv_f_s_f32m1_f32(__riscv_vfredusum_vs_f32m4_f32m1(a3, zero, vlmax));
+    }
+#endif
+
+    for (; i < n; ++i) {
+        const float vx = GGML_CPU_FP16_TO_FP32(x[i]);
+        sum0 += vx * GGML_CPU_FP16_TO_FP32(y[0][i]);
+        sum1 += vx * GGML_CPU_FP16_TO_FP32(y[1][i]);
+        sum2 += vx * GGML_CPU_FP16_TO_FP32(y[2][i]);
+        sum3 += vx * GGML_CPU_FP16_TO_FP32(y[3][i]);
+    }
+
+    s[0] = sum0; s[1] = sum1; s[2] = sum2; s[3] = sum3;
+}
+
+static void ggml_vec_dot_f16_multi_2(int n, float * s, const ggml_fp16_t * x,
+                                     const ggml_fp16_t * const * y) {
+    float sum0 = 0.0f, sum1 = 0.0f;
+    int i = 0;
+
+#if defined(__riscv_v_intrinsic) && defined(__riscv_zvfh)
+    {
+        const size_t vlmax = __riscv_vsetvlmax_e16m2();
+        vfloat32m4_t a0 = __riscv_vfmv_v_f_f32m4(0.0f, vlmax);
+        vfloat32m4_t a1 = __riscv_vfmv_v_f_f32m4(0.0f, vlmax);
+
+        for (; (size_t) (n - i) >= vlmax; i += (int) vlmax) {
+            const size_t vl = __riscv_vsetvl_e16m2(n - i);
+            const vfloat16m2_t vx = __riscv_vle16_v_f16m2((const _Float16 *) (x + i), vl);
+            GGML_F16_DOT4_LOAD(0); GGML_F16_DOT4_FMA(0);
+            GGML_F16_DOT4_LOAD(1); GGML_F16_DOT4_FMA(1);
+        }
+
+        const vfloat32m1_t zero = __riscv_vfmv_v_f_f32m1(0.0f, 1);
+        sum0 = __riscv_vfmv_f_s_f32m1_f32(__riscv_vfredusum_vs_f32m4_f32m1(a0, zero, vlmax));
+        sum1 = __riscv_vfmv_f_s_f32m1_f32(__riscv_vfredusum_vs_f32m4_f32m1(a1, zero, vlmax));
+    }
+#endif
+
+    for (; i < n; ++i) {
+        const float vx = GGML_CPU_FP16_TO_FP32(x[i]);
+        sum0 += vx * GGML_CPU_FP16_TO_FP32(y[0][i]);
+        sum1 += vx * GGML_CPU_FP16_TO_FP32(y[1][i]);
+    }
+
+    s[0] = sum0; s[1] = sum1;
+}
+
+void ggml_vec_dot_f16_multi(int n, float * s, int nout, const ggml_fp16_t * x,
+                            const ggml_fp16_t * const * y) {
+    if (nout == 4) {
+        ggml_vec_dot_f16_multi_4(n, s, x, y);
+    } else if (nout == 2) {
+        ggml_vec_dot_f16_multi_2(n, s, x, y);
+    } else {
+        for (int k = 0; k < nout; ++k) {
+            ggml_vec_dot_f16(n, &s[k], 0, const_cast<ggml_fp16_t *>(x), 0,
+                             const_cast<ggml_fp16_t *>(y[k]), 0, 1);
+        }
+    }
+}
