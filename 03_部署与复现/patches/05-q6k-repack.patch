+// Q6_K: 16 rows interleaved, fused byte transpose (pure size-preserving).
+static int repack_q6_K_to_q6_K_16_bl(struct ggml_tensor * t, int interleave_block, const void * GGML_RESTRICT data, size_t data_size) {
+    GGML_ASSERT(t->type == GGML_TYPE_Q6_K);
+    GGML_ASSERT(interleave_block == 1);
+    constexpr int nrows_interleaved = 16;
+
+    block_q6_Kx16 * dst = (block_q6_Kx16 *) t->data;
+    const block_q6_K * src = (const block_q6_K *) data;
+    const int nrow = ggml_nrows(t);
+    const int nblocks = t->ne[0] / QK_K;
+
+    GGML_ASSERT(data_size == (size_t) nrow * nblocks * sizeof(block_q6_K));
+
+    if (t->ne[1] % nrows_interleaved != 0) {
+        return -1;
+    }
+
+    for (int b = 0; b < nrow; b += nrows_interleaved) {
+        for (int x = 0; x < nblocks; x++) {
+            for (int r = 0; r < nrows_interleaved; r++) {
+                const block_q6_K * in = &src[x + r * nblocks];
+
+                dst->d[r] = in->d;
+                for (int g = 0; g < QK_K / 16; g++) {
+                    dst->sc[g][r] = in->scales[g];
+                }
+                for (int h = 0; h < 2; h++) {
+                    for (int l = 0; l < 32; l++) {
+                        uint8_t * p = dst->qlh[h * 32 + l];
+                        p[r]      = in->ql[h * 64 + l];
+                        p[16 + r] = in->ql[h * 64 + l + 32];
+                        p[32 + r] = in->qh[h * 32 + l];
+                    }
+                }
+            }
+            dst++;
+        }
+        src += nrows_interleaved * nblocks;
+    }
+    return 0;
+
+    GGML_UNUSED(data_size);
+}
